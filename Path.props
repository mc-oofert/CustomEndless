<Project>

  <PropertyGroup>

    <!-- Windows -->
    <!-- C:/Program Files (x86)/Steam/steamapps/common/White Knuckle -->

    <!-- Linux -->
    <!-- $(HOME)/.local/share/Steam/steamapps/common/White Knuckle -->

    <GamePath>E:\Program Files (x86)\Steam\steamapps\common\White Knuckle</GamePath>
    <ManagedPath>$(GamePath)\White Knuckle_Data\Managed</ManagedPath>
    <BepInExPath>$(GamePath)\BepInEx</BepInExPath> <!-- if you dont have bepinex locally installed change this -->

  </PropertyGroup>

</Project>
